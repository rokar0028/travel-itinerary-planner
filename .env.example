# Backend (Render)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional server-side only (not required if using user JWT + anon key)
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Optional AI itinerary for cities other than Goa/Jaipur (falls back to template)
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional: Phase 2 script auto-configures Supabase Auth redirect URLs
# SUPABASE_ACCESS_TOKEN=
# Optional: Phase 2 sync-render-env.ps1
# RENDER_API_KEY=

# Frontend (Vercel) — copy to frontend/.env.local for local dev
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
